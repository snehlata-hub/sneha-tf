{%- liquid
  assign collection_obj = collections[section.settings.collection]
  assign products_limit = section.settings.max_products | default: 8
-%}

<div
  class="fc-carousel color-{{ section.settings.color_scheme }} spacing-style"
  style="--padding-block-start: {{ section.settings['padding-block-start'] }}px; --padding-block-end: {{ section.settings['padding-block-end'] }}px;"
>
  <div class="section section--page-width">
    <div class="fc-carousel__inner">

      <div class="fc-carousel__header">
        <h2 class="fc-carousel__heading">
          {{- section.settings.heading -}}
          {%- if section.settings.heading_accent != blank -%}
            <span class="fc-carousel__heading-accent"> {{ section.settings.heading_accent }}</span>
          {%- endif -%}
        </h2>
        {%- if section.settings.heading_link_text != blank -%}
          {%- if section.settings.heading_link_url != blank -%}
            <a href="{{ section.settings.heading_link_url }}" class="fc-carousel__shop-all">
              {{- section.settings.heading_link_text -}}
            </a>
          {%- else -%}
            <span class="fc-carousel__shop-all">{{ section.settings.heading_link_text }}</span>
          {%- endif -%}
        {%- endif -%}
      </div>

      <div class="fc-carousel__carousel-area">
        <div class="fc-carousel__track">
          {%- if collection_obj != blank -%}
            {%- for product in collection_obj.products limit: products_limit -%}
              {%- liquid
                assign badge_text = product.metafields.ediblearrangement.badge.value
                assign availability_methods = product.metafields.ediblearrangement.availability_method.value
                assign availability_str = availability_methods | join: ','
                assign promo_message = product.metafields.ediblearrangement.promotional_message.value
                assign first_variant = product.selected_or_first_available_variant
                assign variant_option_name = product.options.first | downcase
                assign dots_count = product.images.size
                if dots_count > 5
                  assign dots_count = 5
                endif
              -%}
              <div class="fc-carousel__slide">
                <div class="fc-carousel__card">

                  <div class="fc-card__image-wrap">
                    {%- if badge_text != blank -%}
                      <div class="fc-card__callout">{{ badge_text }}</div>
                    {%- endif -%}
                    {%- assign featured_img = product.featured_image -%}
                    {%- if featured_img != blank -%}
                      <img
                        src="{{ featured_img | image_url: width: 656 }}"
                        srcset="{{ featured_img | image_url: width: 375 }} 375w, {{ featured_img | image_url: width: 550 }} 550w, {{ featured_img | image_url: width: 656 }} 656w"
                        sizes="(min-width: 1024px) 25vw, (min-width: 750px) 50vw, 85vw"
                        alt="{{ featured_img.alt | default: product.title | escape }}"
                        width="328"
                        height="328"
                        loading="lazy"
                        class="fc-card__img"
                      >
                    {%- endif -%}
                    {%- if product.images.size > 1 -%}
                      <div class="fc-card__dots" aria-hidden="true">
                        {%- for i in (1..dots_count) -%}
                          <span class="fc-card__dot{% if forloop.first %} fc-card__dot--active{% endif %}"></span>
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                  </div>

                  <div class="fc-card__info">
                    <div class="fc-card__content">

                      <div class="fc-card__title-area">
                        {%- if availability_str contains 'Same Day' -%}
                          <div class="fc-card__badge">
                            <img
                              src="{{ 'badge-icon-2.svg' | asset_url }}"
                              alt=""
                              width="16"
                              height="16"
                              loading="lazy"
                              class="fc-card__badge-icon"
                            >
                            <span class="fc-card__badge-text">Same Day Delivery</span>
                          </div>
                        {%- endif -%}
                        <a href="{{ product.url }}" class="fc-card__title">{{ product.title }}</a>
                      </div>

                      <div class="fc-card__price-area">
                        {%- if product.variants.size > 1 -%}
                          {%- liquid
                            if variant_option_name == 'title'
                              assign option_label = 'options'
                            else
                              assign option_label = variant_option_name | append: 's'
                            endif
                          -%}
                          <p class="fc-card__variant-count">{{ product.variants.size }} {{ option_label }} available</p>
                        {%- endif -%}
                        <div class="fc-card__price-row">
                          {%- if product.price_varies -%}
                            <span class="fc-card__price">Starting at {{ product.price_min | money }}</span>
                          {%- else -%}
                            <span class="fc-card__price">{{ product.price_min | money }}</span>
                            {%- if product.compare_at_price_max > product.price_min -%}
                              <span class="fc-card__compare-price">{{ product.compare_at_price_max | money }}</span>
                            {%- endif -%}
                          {%- endif -%}
                        </div>
                        {%- if promo_message != blank -%}
                          <p class="fc-card__promo">with code {{ promo_message }}</p>
                        {%- endif -%}
                      </div>

                    </div>

                    <form action="/cart/add" method="post" class="fc-card__atc-form">
                      <input type="hidden" name="id" value="{{ first_variant.id }}">
                      <input type="hidden" name="quantity" value="1">
                      <button type="submit" class="fc-card__atc-btn">Add to Cart</button>
                    </form>
                  </div>

                </div>
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              <div class="fc-carousel__slide">
                <div class="fc-carousel__card fc-carousel__card--placeholder">
                  <div class="fc-card__image-wrap"></div>
                  <div class="fc-card__info">
                    <div class="fc-card__content">
                      <div class="fc-card__title-area">
                        <span class="fc-card__title">Select a collection in settings</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      <div class="fc-carousel__arrows-row">
        <button class="fc-carousel__arrow fc-carousel__arrow--prev" type="button" aria-label="Previous">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M15 18L9 12L15 6" stroke="#1D1D1D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button class="fc-carousel__arrow fc-carousel__arrow--next" type="button" aria-label="Next">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M9 6L15 12L9 18" stroke="#1D1D1D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

    </div>
  </div>
</div>

{% stylesheet %}
/* =========================================
   Featured Products Carousel
   ========================================= */

.fc-carousel__inner {
  display: flex;
  flex-direction: column;
  gap: 32px;
}

/* --- Header --- */
.fc-carousel__header {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.fc-carousel__heading {
  font-family: var(--font-heading--family, var(--font-body--family));
  font-weight: 600;
  font-size: 32px;
  line-height: 38px;
  letter-spacing: -0.64px;
  color: #4A3629;
  margin: 0;
  padding: 0;
}

.fc-carousel__heading-accent {
  color: #E10600;
}

.fc-carousel__shop-all {
  font-family: var(--font-heading--family, var(--font-body--family));
  font-weight: 600;
  font-size: 14px;
  line-height: 20px;
  color: #E10600;
  text-decoration: underline;
  text-underline-offset: 3px;
  display: inline-block;
}

.fc-carousel__shop-all:hover {
  opacity: 0.8;
}

/* --- Carousel area --- */
.fc-carousel__carousel-area {
  width: 100%;
  overflow: hidden;
}

.fc-carousel__track {
  display: flex;
  gap: 16px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  -ms-overflow-style: none;
  width: 100%;
}

.fc-carousel__track::-webkit-scrollbar {
  display: none;
}

/* --- Slides --- */
.fc-carousel__slide {
  flex: 0 0 85%;
  scroll-snap-align: start;
  min-width: 0;
}

/* --- Product Card --- */
.fc-carousel__card {
  border-radius: 24px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  height: 100%;
}

/* --- Image wrap --- */
.fc-card__image-wrap {
  background: linear-gradient(180deg, #F2E7DF 0%, #F5F1F1 100%);
  border-radius: 8px;
  aspect-ratio: 1 / 1;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fc-card__img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

/* Callout badge (e.g. "Trending Now!") */
.fc-card__callout {
  position: absolute;
  top: 0;
  left: 0;
  background: #ffffff;
  border-radius: 0 24px 24px 0;
  padding: 0 8px;
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 12px;
  line-height: 20px;
  color: #1D1D1D;
  z-index: 1;
  white-space: nowrap;
}

/* Gallery dots */
.fc-card__dots {
  position: absolute;
  bottom: 8px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 4px;
  align-items: center;
}

.fc-card__dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: #C6C6C6;
  display: block;
  flex-shrink: 0;
}

.fc-card__dot--active {
  background: #1D1D1D;
}

/* --- Product Info --- */
.fc-card__info {
  display: flex;
  flex-direction: column;
  gap: 16px;
  flex: 1;
}

.fc-card__content {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.fc-card__title-area {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

/* Same Day Delivery badge */
.fc-card__badge {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 2px 0;
}

.fc-card__badge-icon {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
  display: block;
}

.fc-card__badge-text {
  font-family: var(--font-body--family);
  font-weight: 500;
  font-size: 12px;
  line-height: 17px;
  color: #526F1B;
}

/* Product title */
.fc-card__title {
  font-family: var(--font-heading--family, var(--font-body--family));
  font-weight: 600;
  font-size: 14px;
  line-height: 20px;
  color: #1D1D1D;
  text-decoration: none;
  display: block;
  overflow-wrap: break-word;
}

.fc-card__title:hover {
  text-decoration: underline;
}

/* Price area */
.fc-card__price-area {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.fc-card__variant-count {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 14px;
  line-height: 20px;
  color: #1D1D1D;
  margin: 0;
}

.fc-card__price-row {
  display: flex;
  gap: 6px;
  align-items: center;
  flex-wrap: wrap;
}

.fc-card__price {
  font-family: var(--font-body--family);
  font-weight: 500;
  font-size: 12px;
  line-height: 17px;
  color: #1D1D1D;
}

.fc-card__compare-price {
  font-family: var(--font-body--family);
  font-weight: 500;
  font-size: 12px;
  line-height: 17px;
  color: #1D1D1D;
  text-decoration: line-through;
}

.fc-card__promo {
  font-family: var(--font-body--family);
  font-weight: 500;
  font-size: 12px;
  line-height: 17px;
  color: #A00400;
  margin: 0;
}

/* --- ATC Form --- */
.fc-card__atc-form {
  margin-top: auto;
}

.fc-card__atc-btn {
  width: 118px;
  height: 32px;
  border-radius: 24px;
  background-color: #E10600;
  color: #ffffff;
  font-family: var(--font-heading--family, var(--font-body--family));
  font-weight: 600;
  font-size: 12px;
  line-height: 17px;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  transition: opacity 0.2s ease;
}

.fc-card__atc-btn:hover {
  opacity: 0.88;
}

/* --- Arrows row --- */
.fc-carousel__arrows-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 24px;
}

.fc-carousel__arrow {
  width: 32px;
  height: 32px;
  min-width: 32px;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  transition: opacity 0.2s ease;
}

.fc-carousel__arrow--prev {
  opacity: 0.5;
}

.fc-carousel__arrow--next {
  opacity: 1;
}

/* Mobile bottom padding override per Figma (pad:0/16/56/16) */
@media screen and (max-width: 749px) {
  .fc-carousel.spacing-style {
    padding-block-start: 0;
    padding-block-end: 56px;
  }
}

/* =========================================
   Tablet: 750px – 1023px — 2 cards
   ========================================= */
@media screen and (min-width: 750px) {
  .fc-carousel__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    gap: 8px;
  }

  .fc-carousel__heading {
    font-size: 48px;
    line-height: 58px;
    letter-spacing: -0.96px;
  }

  .fc-carousel__shop-all {
    font-size: 16px;
    line-height: 22px;
    white-space: nowrap;
  }

  .fc-carousel__slide {
    flex: 0 0 calc((100% - 16px) / 2);
  }

  .fc-card__dot {
    width: 6px;
    height: 6px;
  }

  .fc-card__title {
    font-size: 16px;
    line-height: 22px;
  }

  .fc-card__price {
    font-size: 14px;
    line-height: 20px;
  }

  .fc-card__compare-price {
    font-size: 14px;
    line-height: 20px;
  }

  .fc-card__promo {
    font-size: 14px;
    line-height: 20px;
  }

  .fc-card__atc-btn {
    width: 100%;
    height: 40px;
    font-size: 14px;
    line-height: 20px;
  }
}

/* =========================================
   Desktop: >=1024px — 4 cards
   ========================================= */
@media screen and (min-width: 1024px) {
  .fc-carousel__track {
    gap: 32px;
  }

  .fc-carousel__slide {
    flex: 0 0 calc((100% - 96px) / 4);
  }
}
{% endstylesheet %}

{% javascript %}
(function () {
  'use strict';

  function initFCCarousels() {
    const carousels = document.querySelectorAll('.fc-carousel');

    carousels.forEach(function (carousel) {
      const track = carousel.querySelector('.fc-carousel__track');
      const prevBtn = carousel.querySelector('.fc-carousel__arrow--prev');
      const nextBtn = carousel.querySelector('.fc-carousel__arrow--next');

      if (!track || !prevBtn || !nextBtn) return;

      function getSlideWidth() {
        const slides = track.querySelectorAll('.fc-carousel__slide');
        if (slides.length < 2) return track.clientWidth;
        return slides[1].offsetLeft - slides[0].offsetLeft;
      }

      function updateArrows() {
        const maxScroll = track.scrollWidth - track.clientWidth;
        prevBtn.style.opacity = track.scrollLeft <= 1 ? '0.5' : '1';
        nextBtn.style.opacity = track.scrollLeft >= maxScroll - 1 ? '0.5' : '1';
      }

      prevBtn.addEventListener('click', function () {
        track.scrollBy({ left: -getSlideWidth(), behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', function () {
        track.scrollBy({ left: getSlideWidth(), behavior: 'smooth' });
      });

      track.addEventListener('scroll', updateArrows, { passive: true });
      updateArrows();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFCCarousels);
  } else {
    initFCCarousels();
  }
})();
{% endjavascript %}

{% schema %}
{
  "name": "Featured Product Carousel",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fresh, sweet,"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent word",
      "info": "Displays in brand red after the heading text",
      "default": "unforgettable"
    },
    {
      "type": "text",
      "id": "heading_link_text",
      "label": "Link text",
      "default": "Shop All Valentine's Day"
    },
    {
      "type": "url",
      "id": "heading_link_url",
      "label": "Link URL"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Max products",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Featured Product Carousel"
    }
  ]
}
{% endschema %}
