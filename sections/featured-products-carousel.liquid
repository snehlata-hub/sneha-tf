{%- liquid
  assign collection_obj = collections[section.settings.collection]
  assign products_limit = section.settings.max_products | default: 8

  assign has_tabs = false
  for block in section.blocks
    if block.type == 'filter-tab'
      assign has_tabs = true
      break
    endif
  endfor

  assign first_tab_block = nil
  for block in section.blocks
    if block.type == 'filter-tab'
      assign first_tab_block = block
      break
    endif
  endfor
-%}

<div
  class="fc-carousel color-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings['padding-block-start'] }}px; padding-bottom: {{ section.settings['padding-block-end'] }}px;"
>
  <div class="fc-carousel__inner">

    <div class="fc-carousel__header">
      <h2 class="fc-carousel__heading">
        {{- section.settings.heading -}}
        {%- if section.settings.heading_accent != blank -%}
          <span class="fc-carousel__heading-accent"> {{ section.settings.heading_accent }}</span>
        {%- endif -%}
        {%- if section.settings.heading_suffix != blank %} {{ section.settings.heading_suffix }}{%- endif -%}
      </h2>
      {%- if has_tabs and first_tab_block -%}
        <a class="fc-carousel__shop-all fc-carousel__shop-all--mobile" href="{{ first_tab_block.settings.url }}" data-shop-all-link>Shop All <span data-shop-all-label>{{ first_tab_block.settings.label }}</span></a>
      {%- elsif section.settings.heading_link_text != blank -%}
        {%- if section.settings.heading_link_url != blank -%}
          <a href="{{ section.settings.heading_link_url }}" class="fc-carousel__shop-all fc-carousel__shop-all--mobile">
            {{- section.settings.heading_link_text -}}
          </a>
        {%- else -%}
          <span class="fc-carousel__shop-all fc-carousel__shop-all--mobile">{{ section.settings.heading_link_text }}</span>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if has_tabs -%}
      <div class="fc-carousel__filters-row">
        <div class="fc-carousel__filters">
          {%- for block in section.blocks -%}
            {%- if block.type == 'filter-tab' -%}
              <button
                class="fc-carousel__chip{% if forloop.first %} fc-carousel__chip--active{% endif %}"
                type="button"
                data-tab-index="{{ forloop.index0 }}"
                aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              >{{ block.settings.label }}</button>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <a class="fc-carousel__shop-all fc-carousel__shop-all--desktop" href="{{ first_tab_block.settings.url }}" data-shop-all-link>Shop All <span data-shop-all-label>{{ first_tab_block.settings.label }}</span></a>
      </div>
    {%- elsif section.settings.heading_link_text != blank -%}
      <div class="fc-carousel__filters-row fc-carousel__filters-row--no-chips">
        {%- if section.settings.heading_link_url != blank -%}
          <a class="fc-carousel__shop-all" href="{{ section.settings.heading_link_url }}">{{ section.settings.heading_link_text }}</a>
        {%- else -%}
          <span class="fc-carousel__shop-all">{{ section.settings.heading_link_text }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if has_tabs -%}
      {%- assign tab_loop_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'filter-tab' -%}
          {%- assign tab_col = collections[block.settings.collection] -%}
          <div
            class="fc-carousel__tab-panel{% if forloop.first %} fc-carousel__tab-panel--active{% endif %}"
            data-tab-index="{{ forloop.index0 }}"
            data-shop-all-url="{{ block.settings.url }}"
            data-tab-label="{{ block.settings.label }}"
          >
            <div class="fc-carousel__carousel-area">
              <div class="fc-carousel__track">
                {%- if tab_col != blank -%}
                  {%- for product in tab_col.products limit: products_limit -%}
                    {%- liquid
                      assign badge_text = product.metafields.ediblearrangement.badge.value
                      assign availability_methods = product.metafields.ediblearrangement.availability_method.value
                      assign availability_str = availability_methods | join: ','
                      assign promo_message = product.metafields.ediblearrangement.promotional_message.value
                      assign first_variant = product.selected_or_first_available_variant
                      assign variant_option_name = product.options.first | downcase
                      assign dots_count = product.images.size
                      if dots_count > 5
                        assign dots_count = 5
                      endif
                    -%}
                    <div class="fc-carousel__slide">
                      <div class="fc-carousel__card">
                        <div class="fc-card__image-wrap">
                          {%- if badge_text != blank -%}
                            <div class="fc-card__callout">{{ badge_text }}</div>
                          {%- endif -%}
                          {%- assign featured_img = product.featured_image -%}
                          {%- if featured_img != blank -%}
                            <img
                              src="{{ featured_img | image_url: width: 656 }}"
                              srcset="{{ featured_img | image_url: width: 375 }} 375w, {{ featured_img | image_url: width: 550 }} 550w, {{ featured_img | image_url: width: 656 }} 656w"
                              sizes="(min-width: 1024px) 25vw, (min-width: 750px) 50vw, 85vw"
                              alt="{{ featured_img.alt | default: product.title | escape }}"
                              width="328"
                              height="328"
                              loading="lazy"
                              class="fc-card__img"
                            >
                          {%- endif -%}
                          {%- if product.images.size > 1 -%}
                            <div class="fc-card__dots" aria-hidden="true">
                              {%- for i in (1..dots_count) -%}
                                <span class="fc-card__dot{% if forloop.first %} fc-card__dot--active{% endif %}"></span>
                              {%- endfor -%}
                            </div>
                          {%- endif -%}
                        </div>
                        <div class="fc-card__info">
                          <div class="fc-card__content">
                            <div class="fc-card__title-area">
                              {%- if availability_str contains 'Same Day' -%}
                                <div class="fc-card__badge">
                                  <img
                                    src="{{ 'badge-icon-2.svg' | asset_url }}"
                                    alt=""
                                    width="16"
                                    height="16"
                                    loading="lazy"
                                    class="fc-card__badge-icon"
                                  >
                                  <span class="fc-card__badge-text">Same Day Delivery</span>
                                </div>
                              {%- endif -%}
                              <a href="{{ product.url }}" class="fc-card__title">{{ product.title }}</a>
                            </div>
                            <div class="fc-card__price-area">
                              {%- if product.variants.size > 1 -%}
                                {%- liquid
                                  if variant_option_name == 'title'
                                    assign option_label = 'options'
                                  else
                                    assign option_label = variant_option_name | append: 's'
                                  endif
                                -%}
                                <p class="fc-card__variant-count">{{ product.variants.size }} {{ option_label }} available</p>
                              {%- endif -%}
                              <div class="fc-card__price-row">
                                {%- if product.price_varies -%}
                                  <span class="fc-card__price">Starting at {{ product.price_min | money }}</span>
                                {%- else -%}
                                  {%- if product.compare_at_price_max > product.price_min -%}
                                    <span class="fc-card__price fc-card__price--on-sale">{{ product.price_min | money }}</span>
                                    <span class="fc-card__compare-price">{{ product.compare_at_price_max | money }}</span>
                                  {%- else -%}
                                    <span class="fc-card__price">{{ product.price_min | money }}</span>
                                  {%- endif -%}
                                {%- endif -%}
                              </div>
                              {%- if promo_message != blank -%}
                                <p class="fc-card__promo">with code {{ promo_message }}</p>
                              {%- endif -%}
                            </div>
                          </div>
                          <form action="/cart/add" method="post" class="fc-card__atc-form">
                            <input type="hidden" name="id" value="{{ first_variant.id }}">
                            <input type="hidden" name="quantity" value="1">
                            <button type="submit" class="fc-card__atc-btn">Add to Cart</button>
                          </form>
                        </div>
                      </div>
                    </div>
                  {%- endfor -%}
                {%- else -%}
                  {%- for i in (1..4) -%}
                    <div class="fc-carousel__slide">
                      <div class="fc-carousel__card fc-carousel__card--placeholder">
                        <div class="fc-card__image-wrap"></div>
                        <div class="fc-card__info">
                          <div class="fc-card__content">
                            <div class="fc-card__title-area">
                              <span class="fc-card__title">Select a collection in settings</span>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  {%- endfor -%}
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      <div class="fc-carousel__carousel-area">
        <div class="fc-carousel__track">
          {%- if collection_obj != blank -%}
            {%- for product in collection_obj.products limit: products_limit -%}
              {%- liquid
                assign badge_text = product.metafields.ediblearrangement.badge.value
                assign availability_methods = product.metafields.ediblearrangement.availability_method.value
                assign availability_str = availability_methods | join: ','
                assign promo_message = product.metafields.ediblearrangement.promotional_message.value
                assign first_variant = product.selected_or_first_available_variant
                assign variant_option_name = product.options.first | downcase
                assign dots_count = product.images.size
                if dots_count > 5
                  assign dots_count = 5
                endif
              -%}
              <div class="fc-carousel__slide">
                <div class="fc-carousel__card">
                  <div class="fc-card__image-wrap">
                    {%- if badge_text != blank -%}
                      <div class="fc-card__callout">{{ badge_text }}</div>
                    {%- endif -%}
                    {%- assign featured_img = product.featured_image -%}
                    {%- if featured_img != blank -%}
                      <img
                        src="{{ featured_img | image_url: width: 656 }}"
                        srcset="{{ featured_img | image_url: width: 375 }} 375w, {{ featured_img | image_url: width: 550 }} 550w, {{ featured_img | image_url: width: 656 }} 656w"
                        sizes="(min-width: 1024px) 25vw, (min-width: 750px) 50vw, 85vw"
                        alt="{{ featured_img.alt | default: product.title | escape }}"
                        width="328"
                        height="328"
                        loading="lazy"
                        class="fc-card__img"
                      >
                    {%- endif -%}
                    {%- if product.images.size > 1 -%}
                      <div class="fc-card__dots" aria-hidden="true">
                        {%- for i in (1..dots_count) -%}
                          <span class="fc-card__dot{% if forloop.first %} fc-card__dot--active{% endif %}"></span>
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                  </div>
                  <div class="fc-card__info">
                    <div class="fc-card__content">
                      <div class="fc-card__title-area">
                        {%- if availability_str contains 'Same Day' -%}
                          <div class="fc-card__badge">
                            <img
                              src="{{ 'badge-icon-2.svg' | asset_url }}"
                              alt=""
                              width="16"
                              height="16"
                              loading="lazy"
                              class="fc-card__badge-icon"
                            >
                            <span class="fc-card__badge-text">Same Day Delivery</span>
                          </div>
                        {%- endif -%}
                        <a href="{{ product.url }}" class="fc-card__title">{{ product.title }}</a>
                      </div>
                      <div class="fc-card__price-area">
                        {%- if product.variants.size > 1 -%}
                          {%- liquid
                            if variant_option_name == 'title'
                              assign option_label = 'options'
                            else
                              assign option_label = variant_option_name | append: 's'
                            endif
                          -%}
                          <p class="fc-card__variant-count">{{ product.variants.size }} {{ option_label }} available</p>
                        {%- endif -%}
                        <div class="fc-card__price-row">
                          {%- if product.price_varies -%}
                            <span class="fc-card__price">Starting at {{ product.price_min | money }}</span>
                          {%- else -%}
                            {%- if product.compare_at_price_max > product.price_min -%}
                              <span class="fc-card__price fc-card__price--on-sale">{{ product.price_min | money }}</span>
                              <span class="fc-card__compare-price">{{ product.compare_at_price_max | money }}</span>
                            {%- else -%}
                              <span class="fc-card__price">{{ product.price_min | money }}</span>
                            {%- endif -%}
                          {%- endif -%}
                        </div>
                        {%- if promo_message != blank -%}
                          <p class="fc-card__promo">with code {{ promo_message }}</p>
                        {%- endif -%}
                      </div>
                    </div>
                    <form action="/cart/add" method="post" class="fc-card__atc-form">
                      <input type="hidden" name="id" value="{{ first_variant.id }}">
                      <input type="hidden" name="quantity" value="1">
                      <button type="submit" class="fc-card__atc-btn">Add to Cart</button>
                    </form>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              <div class="fc-carousel__slide">
                <div class="fc-carousel__card fc-carousel__card--placeholder">
                  <div class="fc-card__image-wrap"></div>
                  <div class="fc-card__info">
                    <div class="fc-card__content">
                      <div class="fc-card__title-area">
                        <span class="fc-card__title">Select a collection in settings</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="fc-carousel__arrows-row">
      <button class="fc-carousel__arrow fc-carousel__arrow--prev" type="button" aria-label="Previous">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M15 18L9 12L15 6" stroke="#1D1D1D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button class="fc-carousel__arrow fc-carousel__arrow--next" type="button" aria-label="Next">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M9 6L15 12L9 18" stroke="#1D1D1D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

  </div>
</div>

{% stylesheet %}
/* Horizontal padding */
.fc-carousel {
  padding-inline: 16px;
}

/* =========================================
   Featured Products Carousel
   ========================================= */

.fc-carousel__inner {
  display: flex;
  flex-direction: column;
  gap: 32px;
}

/* --- Header --- */
.fc-carousel__header {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.fc-carousel__heading {
  font-family: var(--font-heading--family, var(--font-body--family));
  font-weight: 600;
  font-size: 32px;
  line-height: 38px;
  letter-spacing: -0.64px;
  color: #5F0300;
  margin: 0;
  padding: 0;
}

.fc-carousel__heading-accent {
  color: #E10600;
}

/* --- Filters row --- */
.fc-carousel__filters-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.fc-carousel__filters-row--no-chips {
  justify-content: flex-start;
}

.fc-carousel__filters {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;
  flex-wrap: nowrap;
  flex: 1;
  min-width: 0;
}

.fc-carousel__filters::-webkit-scrollbar {
  display: none;
}

/* --- Filter chips --- */
.fc-carousel__chip {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  padding: 6px 12px;
  border-radius: 24px;
  border: 1px solid #EDEDED;
  background: #FFFFFF;
  color: #464646;
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 14px;
  line-height: 20px;
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.15s ease;
}

.fc-carousel__chip--active {
  background: #FCE6E6;
  border-color: #F6B2B0;
  color: #E10600;
  font-weight: 600;
}

.fc-carousel__chip:hover:not(.fc-carousel__chip--active) {
  border-color: #CCCCCC;
}

/* --- Tab panels --- */
.fc-carousel__tab-panel {
  display: none;
}

.fc-carousel__tab-panel--active {
  display: block;
}

/* --- Shop all link --- */
.fc-carousel__shop-all {
  font-family: var(--font-heading--family, var(--font-body--family));
  font-weight: 600;
  font-size: 14px;
  line-height: 20px;
  color: #E10600;
  text-decoration: underline;
  text-underline-offset: 3px;
  display: inline-block;
}

.fc-carousel__shop-all:hover {
  opacity: 0.8;
}

.fc-carousel__shop-all--mobile {
  display: inline-block;
}

.fc-carousel__shop-all--desktop {
  display: none;
}

/* --- Carousel area --- */
.fc-carousel__carousel-area {
  width: 100%;
  overflow: hidden;
}

.fc-carousel__track {
  display: flex;
  gap: 16px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  -ms-overflow-style: none;
  width: 100%;
}

.fc-carousel__track::-webkit-scrollbar {
  display: none;
}

/* --- Slides --- */
.fc-carousel__slide {
  flex: 0 0 85%;
  scroll-snap-align: start;
  min-width: 0;
}

/* --- Product Card --- */
.fc-carousel__card {
  border-radius: 24px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  height: 100%;
}

/* --- Image wrap --- */
.fc-card__image-wrap {
  background: linear-gradient(180deg, #F2E7DF 0%, #F5F1F1 100%);
  border-radius: 8px;
  aspect-ratio: 1 / 1;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fc-card__img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

/* Callout badge (e.g. "Trending Now!") */
.fc-card__callout {
  position: absolute;
  top: 0;
  left: 0;
  background: #ffffff;
  border-radius: 0 24px 24px 0;
  padding: 0 8px;
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 12px;
  line-height: 20px;
  color: #1D1D1D;
  z-index: 1;
  white-space: nowrap;
}

/* Gallery dots */
.fc-card__dots {
  position: absolute;
  bottom: 8px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 4px;
  align-items: center;
}

.fc-card__dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: #C6C6C6;
  display: block;
  flex-shrink: 0;
}

.fc-card__dot--active {
  background: #1D1D1D;
}

/* --- Product Info --- */
.fc-card__info {
  display: flex;
  flex-direction: column;
  gap: 16px;
  flex: 1;
}

.fc-card__content {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.fc-card__title-area {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

/* Same Day Delivery badge */
.fc-card__badge {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 2px 0;
}

.fc-card__badge-icon {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
  display: block;
}

.fc-card__badge-text {
  font-family: var(--font-body--family);
  font-weight: 500;
  font-size: 12px;
  line-height: 17px;
  color: #526F1B;
}

/* Product title */
.fc-card__title {
  font-family: var(--font-heading--family, var(--font-body--family));
  font-weight: 600;
  font-size: 14px;
  line-height: 20px;
  color: #1D1D1D;
  text-decoration: none;
  display: block;
  overflow-wrap: break-word;
}

.fc-card__title:hover {
  text-decoration: underline;
}

/* Price area */
.fc-card__price-area {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.fc-card__variant-count {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 14px;
  line-height: 20px;
  color: #1D1D1D;
  margin: 0;
}

.fc-card__price-row {
  display: flex;
  gap: 6px;
  align-items: center;
  flex-wrap: wrap;
}

.fc-card__price {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 12px;
  line-height: 17px;
  color: #1D1D1D;
}

.fc-card__price--on-sale {
  font-weight: 500;
}

.fc-card__compare-price {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 12px;
  line-height: 17px;
  color: #1D1D1D;
  text-decoration: line-through;
}

.fc-card__promo {
  font-family: var(--font-body--family);
  font-weight: 500;
  font-size: 12px;
  line-height: 17px;
  color: #A00400;
  margin: 0;
}

/* --- ATC Form --- */
.fc-card__atc-form {
  margin-top: auto;
}

.fc-card__atc-btn {
  width: 118px;
  height: 32px;
  border-radius: 24px;
  background-color: #E10600;
  color: #ffffff;
  font-family: var(--font-heading--family, var(--font-body--family));
  font-weight: 600;
  font-size: 12px;
  line-height: 17px;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  transition: opacity 0.2s ease;
}

.fc-card__atc-btn:hover {
  opacity: 0.88;
}

/* --- Arrows row --- */
.fc-carousel__arrows-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 24px;
}

.fc-carousel__arrow {
  width: 32px;
  height: 32px;
  min-width: 32px;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  transition: opacity 0.2s ease;
}

.fc-carousel__arrow--prev {
  opacity: 0.5;
}

.fc-carousel__arrow--next {
  opacity: 1;
}

@media screen and (min-width: 750px) {
  .fc-carousel {
    padding-inline: 40px;
  }

  .fc-carousel__header {
    flex-direction: column;
    gap: 8px;
  }

  .fc-carousel__heading {
    font-size: 48px;
    line-height: 58px;
    letter-spacing: -0.96px;
  }

  .fc-carousel__shop-all--mobile {
    display: none;
  }

  .fc-carousel__shop-all--desktop {
    display: inline-block;
    font-size: 16px;
