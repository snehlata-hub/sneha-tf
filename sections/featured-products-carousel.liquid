{% javascript %}
(function () {
  'use strict';

  function initFCCarousels() {
    var carousels = document.querySelectorAll('.fc-carousel');

    carousels.forEach(function (carousel) {
      var prevBtn = carousel.querySelector('.fc-carousel__arrow--prev');
      var nextBtn = carousel.querySelector('.fc-carousel__arrow--next');

      if (!prevBtn || !nextBtn) return;

      var tabPanels = carousel.querySelectorAll('.fc-carousel__tab-panel');
      var isTabMode = tabPanels.length > 0;

      function getActiveTrack() {
        if (isTabMode) {
          var activePanel = carousel.querySelector('.fc-carousel__tab-panel--active');
          return activePanel ? activePanel.querySelector('.fc-carousel__track') : null;
        }
        return carousel.querySelector('.fc-carousel__track');
      }

      function getSlideWidth(track) {
        if (!track) return 0;
        var slides = track.querySelectorAll('.fc-carousel__slide');
        if (slides.length < 2) return track.clientWidth;
        return slides[1].offsetLeft - slides[0].offsetLeft;
      }

      function updateArrows() {
        var track = getActiveTrack();
        if (!track) return;
        var maxScroll = track.scrollWidth - track.clientWidth;
        prevBtn.style.opacity = track.scrollLeft <= 1 ? '0.5' : '1';
        nextBtn.style.opacity = track.scrollLeft >= maxScroll - 1 ? '0.5' : '1';
      }

      prevBtn.addEventListener('click', function () {
        var track = getActiveTrack();
        if (!track) return;
        track.scrollBy({ left: -getSlideWidth(track), behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', function () {
        var track = getActiveTrack();
        if (!track) return;
        track.scrollBy({ left: getSlideWidth(track), behavior: 'smooth' });
      });

      if (isTabMode) {
        var chips = carousel.querySelectorAll('.fc-carousel__chip');
        var shopAllLinks = carousel.querySelectorAll('[data-shop-all-link]');
        var shopAllLabels = carousel.querySelectorAll('[data-shop-all-label]');

        tabPanels.forEach(function (panel) {
          var track = panel.querySelector('.fc-carousel__track');
          if (track) {
            track.addEventListener('scroll', updateArrows, { passive: true });
          }
        });

        chips.forEach(function (chip) {
          chip.addEventListener('click', function () {
            var tabIndex = chip.getAttribute('data-tab-index');

            chips.forEach(function (c) {
              c.classList.remove('fc-carousel__chip--active');
              c.setAttribute('aria-pressed', 'false');
            });
            chip.classList.add('fc-carousel__chip--active');
            chip.setAttribute('aria-pressed', 'true');

            tabPanels.forEach(function (panel) {
              panel.classList.remove('fc-carousel__tab-panel--active');
            });

            var activePanel = carousel.querySelector('.fc-carousel__tab-panel[data-tab-index="' + tabIndex + '"]');
            if (activePanel) {
              activePanel.classList.add('fc-carousel__tab-panel--active');

              var shopAllUrl = activePanel.getAttribute('data-shop-all-url');
              var tabLabel = activePanel.getAttribute('data-tab-label');

              shopAllLinks.forEach(function (link) {
                if (shopAllUrl) link.setAttribute('href', shopAllUrl);
              });
              shopAllLabels.forEach(function (label) {
                if (tabLabel) label.textContent = tabLabel;
              });

              var newTrack = activePanel.querySelector('.fc-carousel__track');
              if (newTrack) {
                newTrack.scrollLeft = 0;
              }
            }

            updateArrows();
          });
        });
      } else {
        var singleTrack = carousel.querySelector('.fc-carousel__track');
        if (singleTrack) {
          singleTrack.addEventListener('scroll', updateArrows, { passive: true });
        }
      }

      updateArrows();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFCCarousels);
  } else {
    initFCCarousels();
  }
})();
{% endjavascript %}

