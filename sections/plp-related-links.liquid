{%- assign related_links = collection.metafields.ediblearrangement.related_links.value -%}

<div
  class="plp-related-links{% if section.settings.color_scheme != blank %} color-{{ section.settings.color_scheme }}{% endif %}"
  style="
    padding-block-start: {{ section.settings.padding-block-start }}px;
    padding-block-end: {{ section.settings.padding-block-end }}px;
  "
>
  <div class="{% if section.settings.section_width == 'page-width' %}page-width{% endif %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="plp-related-links__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if related_links != blank -%}
      <ul class="plp-related-links__list">
        {%- for link_item in related_links -%}
          <li>
            <a href="{{ link_item.url.value }}">{{ link_item.title.value }}</a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "PLP Related Links",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Related Links"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "number",
      "id": "padding-block-start",
      "label": "Padding top",
      "default": 24
    },
    {
      "type": "number",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "default": 24
    }
  ],
  "blocks": [],
  "presets": [
    { "name": "PLP Related Links" }
  ]
}
{% endschema %}
