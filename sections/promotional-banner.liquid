{%- liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign button_text = section.settings.button_text
  assign button_link = section.settings.button_link
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image
  assign desktop_alt = desktop_image.alt | default: heading
  assign mobile_alt = mobile_image.alt | default: heading
  assign desktop_sizes = '(min-width: 750px) calc(100vw - 128px), 100vw'
  assign mobile_sizes = '(max-width: 749px) calc(100vw - 32px), 358px'
-%}

{% style %}
  #shopify-section-{{ section.id }} .promotional-banner {
    --promotional-banner-padding-top: {{ section.settings['padding-block-start'] }}px;
    --promotional-banner-padding-bottom: {{ section.settings['padding-block-end'] }}px;
  }
{% endstyle %}

<div class="promotional-banner">
  <div class="promotional-banner__container">
    <div class="promotional-banner__media">
      {%- if desktop_image != blank -%}
        {{
          desktop_image
          | image_url: width: desktop_image.width
          | image_tag:
            class: 'promotional-banner__image--desktop',
            sizes: desktop_sizes,
            widths: '750,1100,1408,1780,2000',
            loading: 'lazy',
            alt: desktop_alt
        }}
      {%- endif -%}
      {%- if mobile_image != blank -%}
        {{
          mobile_image
          | image_url: width: mobile_image.width
          | image_tag:
            class: 'promotional-banner__image--mobile',
            sizes: mobile_sizes,
            widths: '375,550,716',
            loading: 'lazy',
            alt: mobile_alt
        }}
      {%- endif -%}
      <div class="promotional-banner__gradient"></div>
    </div>
    <div class="promotional-banner__content">
      <div class="promotional-banner__text">
        {%- if heading != blank -%}
          <h2 class="promotional-banner__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="promotional-banner__subheading">{{ subheading }}</p>
        {%- endif -%}
      </div>
      {%- if button_text != blank -%}
        <a
          href="{{ button_link | default: '#' }}"
          class="promotional-banner__button"
        >
          {{- button_text -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
.promotional-banner {
  background: #ffffff;
  padding-top: var(--promotional-banner-padding-top, 64px);
  padding-bottom: var(--promotional-banner-padding-bottom, 64px);
}

.promotional-banner__container {
  position: relative;
  border-radius: 8px;
  overflow: hidden;
  margin: 0 64px;
  aspect-ratio: 1408 / 588;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.promotional-banner__media {
  position: absolute;
  inset: 0;
}

.promotional-banner__image--desktop,
.promotional-banner__image--mobile {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.promotional-banner__image--mobile {
  display: none;
}

.promotional-banner__gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(26deg, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0) 98%);
}

.promotional-banner__content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 32px;
  padding: 0 64px 48px;
}

.promotional-banner__text {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.promotional-banner__heading {
  font-family: var(--font-heading--family);
  font-size: 48px;
  font-weight: 600;
  line-height: 58px;
  letter-spacing: -0.96px;
  color: #ffffff;
  margin: 0;
  max-width: 581px;
}

.promotional-banner__subheading {
  font-family: var(--font-body--family);
  font-size: 16px;
  font-weight: 400;
  line-height: 22px;
  color: #ffffff;
  margin: 0;
  max-width: 581px;
}

.promotional-banner__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  color: #1d1d1d;
  border-radius: 24px;
  padding: 4px 32px;
  font-family: var(--font-body--family);
  font-size: 16px;
  font-weight: 600;
  line-height: 22px;
  min-height: 48px;
  text-decoration: none;
  align-self: flex-start;
}

.promotional-banner__button:hover {
  opacity: 0.9;
}

@media screen and (max-width: 749px) {
  .promotional-banner {
    padding: 0 16px 16px;
  }

  .promotional-banner__container {
    margin: 0;
    aspect-ratio: 358 / 547;
    justify-content: flex-start;
  }

  .promotional-banner__image--desktop {
    display: none;
  }

  .promotional-banner__image--mobile {
    display: block;
  }

  .promotional-banner__gradient {
    background: linear-gradient(140deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0) 94%);
  }

  .promotional-banner__content {
    padding: 28px 24px 0;
  }

  .promotional-banner__heading {
    font-size: 32px;
    line-height: 38px;
    letter-spacing: -0.64px;
  }

  .promotional-banner__button {
    padding: 4px 24px;
    font-size: 14px;
    line-height: 20px;
    min-height: 40px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Promotional Banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Perfect platters for every gathering"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Fresh fruit, dipped treats, and shareable favorites—beautifully arranged for parties, meetings, and celebrations."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Platters and Boards"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Promotional Banner"
    }
  ]
}
{% endschema %}
