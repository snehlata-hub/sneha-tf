{%- assign blog_handle = section.settings.blog -%}
{%- assign blog_obj = blogs[blog_handle] -%}

<div
  class="blog-article-list{% if section.settings.color_scheme != blank %} color-{{ section.settings.color_scheme }}{% endif %}"
  style="
    padding-block-start: {{ section.settings.padding-block-start }}px;
    padding-block-end: {{ section.settings.padding-block-end }}px;
  "
>
  <div class="{% if section.settings.section_width == 'page-width' %}page-width{% endif %}">
    {% content_for 'blocks' %}

    {%- if blog_obj != blank -%}
      <div class="blog-article-list__grid" style="gap: {{ section.settings.columns_gap }}px;">
        {%- for article in blog_obj.articles limit: section.settings.post_limit -%}
          <article class="blog-article-list__article">
            {%- if article.image -%}
              <a href="{{ article.url }}">
                {{
                  article.image
                  | image_url: width: 800
                  | image_tag:
                    sizes: '(min-width: 750px) 25vw, 100vw',
                    loading: 'lazy',
                    alt: article.image.alt | default: article.title
                }}
              </a>
            {%- endif -%}
            <h3><a href="{{ article.url }}">{{ article.title }}</a></h3>
            <p>{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.blog-article-list__grid {
  display: grid;
  grid-template-columns: repeat(var(--columns, 4), 1fr);

  @media screen and (max-width: 768px) {
    grid-template-columns: repeat(2, 1fr);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Blog Article List",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" }
      ],
      "default": "carousel"
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "Number of posts",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "mobile_card_size",
      "label": "Mobile card size"
    },
    {
      "type": "number",
      "id": "columns_gap",
      "label": "Columns gap",
      "default": 24
    },
    {
      "type": "number",
      "id": "columns_gap_mobile",
      "label": "Mobile columns gap",
      "default": 12
    },
    {
      "type": "number",
      "id": "rows_gap",
      "label": "Rows gap",
      "default": 24
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "Icons style",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "arrows", "label": "Arrows" },
        { "value": "dots", "label": "Dots" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "icons_visibility",
      "label": "Icons visibility",
      "options": [
        { "value": "both", "label": "Both" },
        { "value": "desktop", "label": "Desktop" },
        { "value": "mobile", "label": "Mobile" }
      ],
      "default": "both"
    },
    {
      "type": "select",
      "id": "icons_position",
      "label": "Icons position",
      "options": [
        { "value": "bottom-right", "label": "Bottom right" },
        { "value": "bottom-center", "label": "Bottom center" }
      ],
      "default": "bottom-right"
    },
    {
      "type": "number",
      "id": "icons_gap",
      "label": "Icons gap",
      "default": 24
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "number",
      "id": "gap",
      "label": "Gap",
      "default": 40
    },
    {
      "type": "number",
      "id": "padding-block-start",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" },
    { "type": "_blog-article-card" }
  ],
  "presets": [
    { "name": "Blog Article List" }
  ]
}
{% endschema %}
