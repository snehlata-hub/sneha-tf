{% liquid
  assign block_count = section.blocks.size
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="
    section
    section--page-width
    color-{{ section.settings.color_scheme }}
    popular-categories
    spacing-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
  "
>
  {% if section.settings.heading != blank %}
    <h2 class="popular-categories__heading">
      {{ section.settings.heading | escape }}
    </h2>
  {% endif %}

  {% if block_count > 0 %}
    {% liquid
      assign show_arrows = false
      if section.settings.icons_style != 'none'
        assign show_arrows = true
      endif
    %}

    {% capture slides %}
      {% for block in section.blocks %}
        {% capture card_html %}
          <a
            class="popular-categories__card"
            {% if block.settings.link != blank %}
              href="{{ block.settings.link }}"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <div class="popular-categories__image-wrapper">
              {% if block.settings.image != blank %}
                {% liquid
                  assign sizes_val = '(min-width: 750px) 208px, 156px'
                %}
                {{
                  block.settings.image
                  | image_url: width: block.settings.image.width
                  | image_tag:
                    sizes: sizes_val,
                    widths: '156,208,312,416',
                    loading: 'lazy',
                    class: 'popular-categories__image',
                    alt: block.settings.image.alt
                }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'popular-categories__placeholder' }}
              {% endif %}
            </div>
            {% if block.settings.title != blank %}
              <span class="popular-categories__title">
                {{ block.settings.title | escape }}
              </span>
            {% endif %}
          </a>
        {% endcapture %}

        {% render 'slideshow-slide',
          index: forloop.index0,
          children: card_html,
          class: 'popular-categories__slide'
        %}
      {% endfor %}
    {% endcapture %}

    <div class="popular-categories__carousel-wrapper">
      {% render 'slideshow',
        ref: 'popularCategories',
        class: 'popular-categories__carousel',
        slides: slides,
        show_arrows: show_arrows,
        icon_style: section.settings.icons_style,
        icon_shape: section.settings.icons_shape,
        auto_hide_controls: true,
        infinite: false,
        initial_slide: 0,
        slide_count: block_count
      %}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .popular-categories {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .popular-categories__heading {
    font-family: var(--font-heading--family);
    font-weight: 600;
    font-size: 48px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-align: left;
    color: var(--color-foreground-heading);
    margin: 0;
  }

  .popular-categories__carousel-wrapper {
    width: 100%;
  }

  .popular-categories__carousel {
    --slide-width: 208px;

    width: 100%;
    position: relative;
    container-type: inline-size;
  }

  .popular-categories__carousel slideshow-slides {
    gap: 32px;
    justify-content: center;
    margin-block: -16px;
    padding-block: 16px;
  }

  .popular-categories__carousel slideshow-arrows {
    align-items: center;
  }

  .popular-categories__carousel .slideshow-control {
    opacity: 1;
  }

  .popular-categories__slide {
    width: var(--slide-width);
    flex: 0 0 auto;
    scroll-snap-align: start;
    min-width: 0;
    overflow: visible;
  }

  .popular-categories__card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease;
  }

  .popular-categories__card:hover {
    transform: translateY(-4px);
  }

  .popular-categories__card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
    border-radius: 8px;
  }

  @media (prefers-reduced-motion: reduce) {
    .popular-categories__card:hover {
      transform: none;
    }
  }

  .popular-categories__image-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
  }

  .popular-categories__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .popular-categories__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .popular-categories__title {
    display: block;
    font-family: var(--font-heading--family);
    font-weight: 600;
    font-size: 16px;
    line-height: 22px;
    text-align: center;
    color: var(--color-foreground-heading);
  }

  /* Mobile overrides */
  @media screen and (max-width: 749px) {
    .popular-categories {
      gap: 32px;
      --padding-block-start: 0px !important;
      --padding-block-end: 56px !important;
    }

    .popular-categories__heading {
      font-size: 32px;
      text-align: start;
    }

    .popular-categories__carousel {
      --slide-width: calc(50% - 12px);
    }

    .popular-categories__carousel slideshow-slides {
      flex-wrap: wrap;
      overflow: visible !important;
      scroll-snap-type: none;
      gap: 24px;
      justify-content: center;
    }

    .popular-categories__carousel slideshow-container {
      overflow: visible;
    }

    .popular-categories__carousel slideshow-component {
      overflow: visible;
    }

    .popular-categories__carousel slideshow-component:not([in-viewport]) slideshow-slides {
      overflow: visible;
    }

    .popular-categories__carousel slideshow-slide {
      content-visibility: visible;
    }

    .popular-categories__carousel slideshow-arrows {
      display: none;
    }

    .popular-categories__slide {
      overflow: visible;
    }

    .popular-categories__card {
      gap: 8px;
    }

    .popular-categories__image-wrapper {
      border-radius: 6px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

    .popular-categories__title {
      font-size: 14px;
      line-height: 20px;
      text-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Popular categories",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Popular categories"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "Arrow style",
      "options": [
        { "value": "arrow", "label": "Arrow" },
        { "value": "chevron", "label": "Chevron" },
        { "value": "arrows_large", "label": "Arrow large" },
        { "value": "chevron_large", "label": "Chevron large" },
        { "value": "none", "label": "None" }
      ],
      "default": "arrow"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "Arrow shape",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "circle", "label": "Circle" },
        { "value": "square", "label": "Square" }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "category-card",
      "name": "Category card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Popular categories",
      "blocks": [
        {
          "type": "category-card",
          "settings": {
            "title": "Birthday"
          }
        },
        {
          "type": "category-card",
          "settings": {
            "title": "Same Day Delivery"
          }
        },
        {
          "type": "category-card",
          "settings": {
            "title": "Catering"
          }
        },
        {
          "type": "category-card",
          "settings": {
            "title": "1-Hour Delivery"
          }
        },
        {
          "type": "category-card",
          "settings": {
            "title": "Create Your Own"
          }
        },
        {
          "type": "category-card",
          "settings": {
            "title": "Shop All"
          }
        }
      ]
    }
  ]
}
{% endschema %}
