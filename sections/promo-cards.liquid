{% liquid
  assign section_width = section.settings.section_width
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-testid="promo-cards-{{ section.id }}"
>
  <div
    class="promo-cards__grid{% if section.settings.show_divider %} promo-cards__grid--divider{% endif %}"
    {% if section.settings.show_divider %}
      style="--promo-cards-divider-color: {{ section.settings.divider_color }};"
    {% endif %}
  >
    {% for block in section.blocks %}
      {% liquid
        assign overlay_color = block.settings.overlay_color
        assign overlay_r = overlay_color | color_extract: 'red'
        assign overlay_g = overlay_color | color_extract: 'green'
        assign overlay_b = overlay_color | color_extract: 'blue'

        assign desktop_image = block.settings.background_image
        assign mobile_image = block.settings.mobile_image
        assign has_desktop_image = false
        assign has_mobile_image = false
        if desktop_image != blank
          assign has_desktop_image = true
        endif
        if mobile_image != blank
          assign has_mobile_image = true
        endif
        assign fallback_image = mobile_image | default: desktop_image
      %}

      <div
        class="promo-card"
        style="--promo-card-overlay-rgb: {{ overlay_r }}, {{ overlay_g }}, {{ overlay_b }};"
        {{ block.shopify_attributes }}
      >
        {% if has_desktop_image or has_mobile_image %}
          {% assign img_alt = fallback_image.alt | default: block.settings.heading %}
          <picture class="promo-card__media">
            {% if has_desktop_image and has_mobile_image %}
              <source
                media="(min-width: 750px)"
                srcset="{{ desktop_image | image_url: width: desktop_image.width }}"
              >
            {% endif %}
            {% assign sizes_val = '(min-width: 750px) 50vw, 100vw' %}
            {{ fallback_image | image_url: width: fallback_image.width | image_tag:
              sizes: sizes_val,
              widths: '375,550,750,1100,1500',
              loading: 'lazy',
              class: 'promo-card__image',
              alt: img_alt
            }}
          </picture>
        {% endif %}

        <div class="promo-card__content">
          <div class="promo-card__text-group">
            {% if block.settings.subtitle != blank %}
              <p class="promo-card__subtitle">{{ block.settings.subtitle | escape }}</p>
            {% endif %}

            {% if block.settings.heading != blank %}
              <h2 class="promo-card__heading">{{ block.settings.heading | escape }}</h2>
            {% endif %}

            {% if block.settings.description != blank %}
              <p class="promo-card__description">{{ block.settings.description | escape }}</p>
            {% endif %}
          </div>

          {% if block.settings.button_text != blank %}
            <a
              {% if block.settings.button_link != blank %}
                href="{{ block.settings.button_link }}"
              {% endif %}
              class="promo-card__cta"
            >
              {{ block.settings.button_text | escape }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .promo-cards__grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;

    @media screen and (min-width: 750px) {
      flex-direction: row;
      gap: 32px;
      align-items: stretch;
    }
  }

  .promo-cards__grid--divider {
    @media screen and (min-width: 750px) {
      position: relative;
    }

    &::after {
      @media screen and (min-width: 750px) {
        content: '';
        position: absolute;
        top: 10%;
        bottom: 10%;
        left: 50%;
        transform: translateX(-50%);
        width: 1px;
        background-color: var(--promo-cards-divider-color, #E0E0E0);
        pointer-events: none;
        z-index: 1;
      }
    }
  }

  .promo-card {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    padding: 24px;
    height: 206px;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;

    @media screen and (min-width: 750px) {
      padding: 40px;
      height: 302px;
    }

    &::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      border-radius: 8px;
      background: linear-gradient(
        to right,
        rgba(var(--promo-card-overlay-rgb), 1) 0%,
        rgba(var(--promo-card-overlay-rgb), 1) 35%,
        rgba(var(--promo-card-overlay-rgb), 0.8) 50%,
        rgba(var(--promo-card-overlay-rgb), 0) 68%
      );
      pointer-events: none;
    }
  }

  .promo-card__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
  }

  .promo-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    border-radius: 8px;
  }

  .promo-card__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    max-width: 75%;

    @media screen and (min-width: 750px) {
      gap: 24px;
      max-width: 55%;
    }
  }

  .promo-card__text-group {
    display: flex;
    flex-direction: column;
    gap: 4px;

    @media screen and (min-width: 750px) {
      gap: 6px;
    }
  }

  .promo-card__subtitle {
    font-family: var(--font-subheading--family);
    font-weight: 500;
    font-size: 12px;
    line-height: 17px;
    text-transform: uppercase;
    color: var(--color-foreground-heading);
    margin: 0;

    @media screen and (min-width: 750px) {
      font-size: 14px;
      line-height: 20px;
    }
  }

  .promo-card__heading {
    font-family: var(--font-heading--family);
    font-weight: 600;
    font-size: 20px;
    line-height: 24px;
    color: var(--color-foreground-heading);
    margin: 0;

    @media screen and (min-width: 750px) {
      font-size: 32px;
      line-height: 38px;
      letter-spacing: -0.64px;
    }
  }

  .promo-card__description {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-foreground);
    margin: 0;

    @media screen and (min-width: 750px) {
      font-size: 16px;
      line-height: 22px;
    }
  }

  .promo-card__cta {
    display: inline-block;
    align-self: flex-start;
    font-family: var(--font-body--family);
    font-weight: 600;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-foreground-heading);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;

    @media screen and (min-width: 750px) {
      font-size: 16px;
      line-height: 22px;
      padding-bottom: 3px;
    }

    &:hover {
      opacity: 0.75;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Promo cards",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "full-width", "label": "Full width" },
        { "value": "page-width", "label": "Page width" },
        { "value": "narrow", "label": "Narrow" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Divider"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider",
      "default": true
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#E0E0E0"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "promo-card",
      "name": "Promo card",
      "settings": [
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "SUBTITLE"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Card heading"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Short description text."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "header",
          "content": "Media"
        },
        {
          "type": "image_picker",
          "id": "background_image",
          "label": "Background image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "header",
          "content": "Overlay"
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "Overlay color",
          "default": "#FBF7F5"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo cards",
      "blocks": [
        {
          "type": "promo-card",
          "settings": {
            "subtitle": "BIRTHDAY COLLECTION",
            "heading": "Don't forget to make it sweet",
            "description": "Send same-day treats they'll love.",
            "button_text": "Shop Birthday",
            "overlay_color": "#FBF7F5"
          }
        },
        {
          "type": "promo-card",
          "settings": {
            "subtitle": "BUY MORE, SAVE MORE",
            "heading": "Get up to 20% off",
            "description": "Bundle up our best products.",
            "button_text": "Create Your Bundle",
            "overlay_color": "#F6F6F4"
          }
        }
      ]
    }
  ]
}
{% endschema %}
