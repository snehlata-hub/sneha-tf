<li
  {{ block.shopify_attributes }}
  class="header-nav-item{% if block.settings.visibility == 'desktop' %} header-nav-item--desktop-only{% elsif block.settings.visibility == 'mobile' %} header-nav-item--mobile-only{% endif %}{% if block.settings.asset_icon != blank %} header-nav-item--has-asset-icon{% endif %}"
  style="color: {{ block.settings.text_color }};"
>
  <a
    href="{{ block.settings.link | default: '#' }}"
    class="header-nav-item__link"
  >
    {%- if block.settings.asset_icon != blank -%}
      <span class="header-nav-item__asset-icon">{{- block.settings.asset_icon | inline_asset_content -}}</span>
    {%- endif -%}
    {%- if block.settings.icon != blank -%}
      <img
        src="{{ block.settings.icon | image_url: width: 28 }}"
        alt=""
        class="header-nav-item__icon"
        width="14"
        height="14"
        loading="lazy"
      >
    {%- endif -%}
    <span class="header-nav-item__title">{{ block.settings.title }}</span>
    {%- if block.settings.submenu != blank -%}
      <span class="header-nav-item__chevron">
        {{- 'chevron-down.svg' | inline_asset_content -}}
      </span>
    {%- endif -%}
  </a>
  {%- if block.settings.submenu != blank -%}
    <div class="header-nav-item__dropdown">
      {% content_for 'blocks' %}
    </div>
  {%- endif -%}
</li>

{% stylesheet %}
  .header-nav-item {
    list-style: none;
    display: flex;
    align-items: center;
    position: relative;
  }

  .header-nav-item__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-radius: 48px;
    padding: 8px;
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    color: inherit;
    font-family: var(--font-heading--family);
    transition: opacity var(--animation-speed) var(--animation-easing);
  }

  .header-nav-item__link:hover {
    opacity: 0.7;
  }

  .header-nav-item__icon {
    height: 14px;
    width: auto;
    flex-shrink: 0;
  }

  .header-nav-item__chevron {
    display: inline-flex;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .header-nav-item__chevron svg {
    width: 100%;
    height: 100%;
  }

  .header-nav-item:hover .header-nav-item__chevron {
    transform: rotate(180deg);
  }

  /* Dropdown */
  .header-nav-item__dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    z-index: 200;
    background-color: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 12px;
    padding: 16px;
    gap: 12px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    min-width: 280px;
    flex-direction: row;
    flex-wrap: wrap;
  }

  .header-nav-item:hover .header-nav-item__dropdown {
    display: flex;
  }

  /* Mobile drawer styles */
  .header__mobile-drawer .header-nav-item {
    width: 100%;
  }

  .header__mobile-drawer .header-nav-item__link {
    width: 100%;
    border-radius: 0;
    padding: 12px 0;
    font-size: 16px;
    line-height: 24px;
    border-bottom: 1px solid var(--color-border, #E5E5E5);
  }

  .header-nav-item--mobile-only {
    display: none;
  }

  .header__mobile-drawer .header-nav-item--desktop-only {
    display: none;
  }

  .header__mobile-drawer .header-nav-item--mobile-only {
    display: flex;
  }

  .header__mobile-drawer .header-nav-item__dropdown {
    display: block;
    position: static;
    box-shadow: none;
    border: none;
    border-radius: 0;
    padding: 0 0 8px 12px;
    background: transparent;
    min-width: 0;
  }

  .header__mobile-drawer .header-nav-item:hover .header-nav-item__dropdown {
    display: block;
  }

  .header-nav-item__asset-icon {
    display: inline-flex;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .header-nav-item__asset-icon svg {
    width: 100%;
    height: 100%;
  }

  .header-nav-item--has-asset-icon .header-nav-item__link {
    padding-block: 4px;
    padding-inline: 16px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nav Item",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Menu item"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "submenu",
      "label": "Submenu handle"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Icon image"
    },
    {
      "type": "text",
      "id": "asset_icon",
      "label": "Asset icon filename (SVG)",
      "info": "Filename of an SVG in the theme assets folder, e.g. heart-plus.svg. Rendered inline for CSS color control."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1d1d1d"
    },
    {
      "type": "text",
      "id": "highlight_titles",
      "label": "Highlight text"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight color",
      "default": "#e10600"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Visibility",
      "options": [
        { "value": "both", "label": "Both" },
        { "value": "desktop", "label": "Desktop only" },
        { "value": "mobile", "label": "Mobile only" }
      ],
      "default": "both"
    }
  ],
  "blocks": [
    { "type": "_header-nav-promo-banner" }
  ]
}
{% endschema %}
