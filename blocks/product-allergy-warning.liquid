{%- if product.metafields.ediblearrangement.allergy_information != blank -%}
  <div {{ block.shopify_attributes }} class="product-allergy-warning" style="background-color: {{ block.settings.background_color }}; padding: 12px 16px; border-radius: 4px;">
    {{ product.metafields.ediblearrangement.allergy_information.value | metafield_tag }}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product allergy warning",
  "tag": null,
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fbf7f5"
    }
  ]
}
{% endschema %}
