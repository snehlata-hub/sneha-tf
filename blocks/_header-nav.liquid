<nav {{ block.shopify_attributes }} class="header-nav" aria-label="Main navigation">
  <ul class="header-nav__list">
    {% content_for 'blocks' %}
  </ul>
</nav>

{% stylesheet %}
  .header-nav__list {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media screen and (max-width: 749px) {
    .header-nav {
      display: none;
    }
  }

  .header__mobile-drawer .header-nav {
    display: block;
  }

  .header__mobile-drawer .header-nav__list {
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    padding: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header Navigation",
  "tag": null,
  "settings": [],
  "blocks": [
    { "type": "_header-navigation-item" },
    { "type": "_mobile-menu-carousel" },
    { "type": "_header-nav-promo-banner" },
    { "type": "links" },
    { "type": "@app" }
  ]
}
{% endschema %}
