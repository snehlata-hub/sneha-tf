<div {{ block.shopify_attributes }} class="search-drawer">
  {%- if block.settings.title != blank -%}
    <p class="search-drawer__title">{{ block.settings.title }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search Drawer",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Bestseller"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "top_searchs",
      "label": "Top searches (comma separated)"
    }
  ]
}
{% endschema %}
