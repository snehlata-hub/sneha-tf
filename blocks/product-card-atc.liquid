<div
  {{ block.shopify_attributes }}
  class="product-card-atc{% if block.settings.color_scheme != blank %} color-{{ block.settings.color_scheme }}{% endif %}"
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .product-card-atc .button[aria-disabled='true'],
  .product-card-atc .button-primary[aria-disabled='true'] {
    opacity: 1;
    cursor: pointer;
  }

  .product-card-atc .button,
  .product-card-atc .button-primary {
    justify-content: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product Card ATC",
  "tag": null,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    }
  ],
  "blocks": [
    { "type": "button" },
    { "type": "quantity" },
    { "type": "accelerated-checkout" },
    { "type": "@app" }
  ]
}
{% endschema %}
